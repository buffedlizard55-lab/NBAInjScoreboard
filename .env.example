# Supabase free tier - create project at https://supabase.com
# Then run db/schema.sql in SQL editor
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Optional: override port
PORT=3000

# Optional: for old editorial intake (NBA only)
# INJURY_INGEST_TOKEN=generate-long-random-token-24+chars

# For local testing without Supabase, leave SUPABASE vars empty - uses in-memory DB
